# Copy to .env for local runs. NEVER commit .env.
# In CI these same names are GitHub Actions secrets — see README "Secrets".
#
# Each block below is required only once its phase is implemented.

# --- YouTube detection + licence verification (Phase 1 optional, Phase 2 REQUIRED)
#
# An API KEY, not OAuth — detection and the licence check only read public
# data. The OAuth block further down is for uploading, and is unrelated.
#
# Setup: https://console.cloud.google.com/
#   1. Create (or pick) a project
#   2. APIs & Services > Library > enable "YouTube Data API v3"
#   3. APIs & Services > Credentials > Create credentials > API key
#   4. Restrict the key to the YouTube Data API v3
#
# Phase 1 works without it by falling back to YouTube's Atom feed, but that
# endpoint 404s intermittently from datacenter IPs (i.e. from CI).
# Phase 2 REQUIRES it: the per-video Creative Commons licence check runs
# through the Data API, and an unverifiable video is never downloaded.
YOUTUBE_API_KEY=

# --- Branding (Phase 5) ------------------------------------------------------
BRAND_NAME=

# --- Transcription (Phase 3) -------------------------------------------------
# Groq free tier: Whisper large-v3-turbo, no card required.
# https://console.groq.com/keys
TRANSCRIPTION_API_KEY=

# --- Clip selection LLM (Phase 4) -------------------------------------------
# Google AI Studio free tier, no billing account required.
# https://aistudio.google.com/apikey
#
# Optional: with no key, clip selection uses a heuristic scorer (keyword and
# structure signals, no network) instead of Gemini. Verify with:
#   python -m src.main doctor
LLM_API_KEY=

# --- YouTube (Phase 6) -------------------------------------------------------
# All three or none — `publish` skips YouTube entirely if any is missing.
#
# NOTE: uploads from an un-audited API project are LOCKED PRIVATE by YouTube,
# whatever privacyStatus you send. See docs/LIMITS.md section 2 before you
# expect public Shorts to appear — this is a platform gate, not a bug here.
#
# Setup (one-time, by hand — this project's code never runs an OAuth consent
# flow, only the refresh-token exchange it produces):
#   1. Google Cloud Console > APIs & Services > Library > enable
#      "YouTube Data API v3" (same project as YOUTUBE_API_KEY above is fine)
#   2. APIs & Services > OAuth consent screen > add yourself as a test user
#      (an app in "Testing" status works for this; publishing is unlisted
#      until the separate compliance audit passes regardless — LIMITS §2)
#   3. APIs & Services > Credentials > Create credentials > OAuth client ID >
#      Application type: Desktop app
#   4. Use Google's OAuth 2.0 Playground (https://developers.google.com/oauthplayground)
#      or any installed-app flow with your client id/secret and scope
#      https://www.googleapis.com/auth/youtube.upload to complete consent
#      once and obtain a REFRESH token (not the access token — that one
#      expires in an hour; the refresh token is what this project stores)
#   5. Verify with: python -m src.main doctor   (no quota spent — it only
#      exchanges the refresh token, it does not upload anything)
#
# A refresh token for an app in "Testing" publishing status can be revoked
# by Google after 7 days of inactivity or if the test-user list changes —
# `doctor` is how you find out before a scheduled `publish` run does.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Instagram (Phase 7) -----------------------------------------------------
# Both or neither — `publish` skips Instagram entirely if either is missing.
#
# Requires an Instagram Professional (Business/Creator) account linked to a
# Facebook Page. Setup:
#   1. developers.facebook.com > My Apps > Create App > type "Business"
#   2. Add the "Instagram Graph API" product
#   3. Generate a User or Page access token with the instagram_content_publish
#      and instagram_basic permissions (Graph API Explorer is the fastest way
#      to do this once by hand) — Meta's long-lived tokens last ~60 days and
#      must be refreshed manually; there is no refresh-token flow here like
#      YouTube's, so re-generating periodically is this project's own job,
#      not automated
#   4. INSTAGRAM_ACCOUNT_ID is the Instagram Business Account id (NOT the
#      Facebook Page id) — Graph API Explorer: GET /me/accounts, then for the
#      page: GET /{page-id}?fields=instagram_business_account
#   5. Verify with: python -m src.main doctor
#
# Publishing also needs GITHUB_TOKEN + GITHUB_REPOSITORY (see README
# "Publishing" — Instagram's API fetches the clip from a public URL rather
# than accepting a direct upload, and these are what host it temporarily).
# In GitHub Actions both are provided automatically; nothing to set there.
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- TikTok (Phase 8) --------------------------------------------------------
# NOTE: an un-audited TikTok client can only post SELF_ONLY (private).
# See docs/LIMITS.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
